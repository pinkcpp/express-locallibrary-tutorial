#!/usr/bin/env node

/**
 * 应用启动入口：解析端口、创建 HTTP 服务、处理监听异常。
 */

// 未显式指定环境时按生产环境运行（npm start / node ./bin/www），连接 Atlas 云端库；
// 本地开发请使用 npm run dev（development，连接本地库）
process.env.NODE_ENV = process.env.NODE_ENV || 'production';

const app = require('../app');
const debug = require('debug')('express-locallibrary-tutorial:server');
const http = require('http');

// 从环境变量读取端口并存入 Express 设置
const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

// 创建 HTTP 服务
const server = http.createServer(app);

// 在所有网络接口上监听
server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * 将端口值规范化为数字、命名管道或 false。
 * @param {string} val 端口字符串
 * @returns {number|string|false} 规范化后的端口
 */
function normalizePort(val) {
  const port = parseInt(val, 10);

  if (Number.isNaN(port)) {
    // 命名管道
    return val;
  }

  if (port >= 0) {
    // 端口号
    return port;
  }

  return false;
}

/**
 * HTTP 服务 error 事件监听器。
 * @param {NodeJS.ErrnoException} error 监听错误
 * @returns {void}
 */
function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  const bind = typeof port === 'string' ? `Pipe ${port}` : `Port ${port}`;

  // 针对常见监听错误给出友好提示
  switch (error.code) {
    case 'EACCES':
      console.error(`${bind} requires elevated privileges`);
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(`${bind} is already in use`);
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * HTTP 服务 listening 事件监听器。
 * @returns {void}
 */
function onListening() {
  const addr = server.address();
  const bind = typeof addr === 'string' ? `pipe ${addr}` : `port ${addr.port}`;
  debug(`Listening on ${bind}`);
}
